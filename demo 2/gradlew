#!/usr/bin/env sh
set -eu

GRADLE_VERSION="9.7.1"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"

# Reuse the official Gradle Wrapper distribution already downloaded by Lab 3, if present.
for candidate in "$GRADLE_USER_HOME"/wrapper/dists/gradle-"$GRADLE_VERSION"-bin/*/gradle-"$GRADLE_VERSION"/bin/gradle; do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

# Fall back to downloading the official Gradle distribution (the binary wrapper JAR is not needed).
INSTALL_DIR="$GRADLE_USER_HOME/course-gradle/gradle-$GRADLE_VERSION"
GRADLE_BIN="$INSTALL_DIR/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
    command -v curl >/dev/null 2>&1 || { echo "curl is required to download Gradle $GRADLE_VERSION" >&2; exit 1; }
    command -v unzip >/dev/null 2>&1 || { echo "unzip is required to unpack Gradle $GRADLE_VERSION" >&2; exit 1; }
    mkdir -p "$GRADLE_USER_HOME/course-gradle"
    TMP_DIR=$(mktemp -d "$GRADLE_USER_HOME/course-gradle/tmp.XXXXXX")
    trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
    curl --fail --location --retry 3 \
      "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" \
      --output "$TMP_DIR/gradle.zip"
    unzip -q "$TMP_DIR/gradle.zip" -d "$TMP_DIR"
    mv "$TMP_DIR/gradle-$GRADLE_VERSION" "$INSTALL_DIR"
fi

exec "$GRADLE_BIN" "$@"
